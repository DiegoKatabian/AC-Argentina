  m_Script: {fileID: 11500000, guid: 60a3f8b212786a649aefe54d4368b171, type: 3}
  m_Name: SubtitleSet_04
  m_EditorClassIdentifier: 
  subtitles:
  - characterName: 1
    text: "You made me sweat, kid. The old man was right, you're good. But if you
      had stopped as I asked, you would know that I didn\u2019t come to harm you."
  - characterName: 1
    text: Are you listening or are you deaf? I'm not here to fight.
  - characterName: 1
    text: Alright, when I'm done with you I'll tell you what I'm here for.
